# Maintainer: mrrizkin <io.github.mrrizkin>
#
# AUR package for the VCS checkout. There are no release tags yet, so a
# versioned package would have nothing to point at; `pkgver()` derives the
# version from the clone instead, which is the standard -git pattern.
#
# Build locally with:  makepkg -si
# Push to AUR with:    makepkg --printsrcinfo > .SRCINFO
pkgname=kin-galeri-git
pkgver=2026.42.0
pkgrel=1
pkgdesc='Fast local photo and video library for Linux, built with Qt 6/QML'
# x86_64 only: the pinned ONNX Runtime archive is the x64 CPU build, and
# aarch64 would need a matching archive and checksum of its own.
arch=('x86_64')
url='https://github.com/mrrizkin/KinGaleri'
license=('GPL3')
depends=(
    'qt6-base'
    'qt6-declarative'
    'qt6-svg'
    'qt6-multimedia'
    'sqlite'
    'ffmpeg'
)
makedepends=(
    'cmake'
    'ninja'
    'git'
    # Arch packages mpvqt, so the mpv backend is built in here. It is the
    # preferred backend (and the only one that can seek precisely), but the app
    # falls back to Qt Multimedia when it is missing.
    'mpvqt'
)
optdepends=(
    'libheif: heif-convert, used for HEIC/HEIF thumbnails'
    'mpv: libmpv itself, pulled in by mpvqt'
)
provides=('kin-galeri')
conflicts=('kin-galeri')
# The VCS checkout, plus ONNX Runtime for face grouping. Arch has no onnxruntime
# package at all, so the official CPU build is pinned by tag and sha256 and shipped
# in the package - the same archive the AppImage and the Flatpak manifest use.
# Note the library is installed as libonnxruntime.so.1 (its SONAME), which is what
# makes it usable by this package without a dependency; if distro packages for
# onnxruntime ever appear, this copy is what would need revisiting.
source=(
    "$pkgname::git+$url.git"
    "onnxruntime-linux-x64-1.20.1.tgz::https://github.com/microsoft/onnxruntime/releases/download/v1.20.1/onnxruntime-linux-x64-1.20.1.tgz"
)
sha256sums=(
    'SKIP'
    '67db4dc1561f1e3fd42e619575c82c601ef89849afc7ea85a003abbac1a1a105'
)

pkgver() {
    cd "$pkgname"
    # Tags follow vYYYY.WW.PATCH (year.ISO-week.patch), so a tagged checkout already
    # carries the right version and `git describe` only needs its separators
    # rewritten: v2026.42.0-3-gabcdef becomes 2026.42.0.r3.gabcdef. Without an
    # ancestor tag (or in a shallow clone) fall back to the commit count, which
    # still increases monotonically for AUR.
    local described
    described="$(git describe --long --tags --match 'v[0-9]*' 2>/dev/null || true)"
    if [[ -n "$described" ]]; then
        # At a tagged commit, `git describe --long` reports -0-g<hash>; drop that so
        # a release build is simply the version, and keep the .r<n>.g<hash> suffix
        # only for the commits in between releases.
        printf '%s' "$described" | sed -E 's/^v//; s/-0-g[0-9a-f]+$//; s/-([0-9]+)-g/.r\1.g/'
    else
        printf '%s.r%s.g%s' \
            "$pkgver" \
            "$(git rev-list --count HEAD)" \
            "$(git rev-parse --short HEAD)"
    fi
}

build() {
    # Tests are built here rather than in check() so the object files are shared.
    # Face grouping is on: the ORT archive above is extracted into $srcdir and
    # pointed at directly, and KG_ENABLE_ML fails the build if it is not found
    # (it used to warn and quietly drop the feature, which is how a binary could
    # lose face grouping without anyone noticing).
    cmake -S "$pkgname" -B build -G Ninja \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DKG_BUILD_TESTS=ON \
        -DKG_ENABLE_ML=ON \
        -DKG_ORT_ROOT="$srcdir/onnxruntime-linux-x64-1.20.1"
    cmake --build build
}

check() {
    # The test harness already forces QT_QPA_PLATFORM=offscreen per test.
    ctest --test-dir build --output-on-failure
}

package() {
    DESTDIR="$pkgdir" cmake --install build
    install -Dm644 "$pkgname/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"

    # ONNX Runtime: the symlink chain and the real library, plus its licence.
    install -d "$pkgdir/usr/lib"
    cp -a "$srcdir"/onnxruntime-linux-x64-1.20.1/lib/libonnxruntime*.so* "$pkgdir/usr/lib/"
    install -Dm644 "$srcdir/onnxruntime-linux-x64-1.20.1/LICENSE" \
        "$pkgdir/usr/share/licenses/$pkgname/LICENSE.onnxruntime"
}
